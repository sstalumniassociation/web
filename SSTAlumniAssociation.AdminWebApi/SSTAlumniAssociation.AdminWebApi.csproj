<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FastEndpoints" Version="5.34.0" />
        <PackageReference Include="FastEndpoints.ClientGen.Kiota" Version="5.34.0" />
        <PackageReference Include="FastEndpoints.Swagger" Version="5.34.0" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.0.20" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.2" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.2" />
        <PackageReference Include="Riok.Mapperly" Version="4.1.1" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SSTAlumniAssociation.Core\SSTAlumniAssociation.Core.csproj"/>
        <ProjectReference Include="..\SSTAlumniAssociation.Migrations\SSTAlumniAssociation.Migrations.csproj"/>
        <ProjectReference Include="..\SSTAlumniAssociation.ServiceDefaults\SSTAlumniAssociation.ServiceDefaults.csproj"/>
    </ItemGroup>

    <Target Name="ClientGen" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
        <Exec WorkingDirectory="$(RunWorkingDirectory)"
              Command="$(RunCommand) --generateclients true --urls http://localhost:5000" />
    </Target>

</Project>
